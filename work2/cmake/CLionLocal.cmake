# GCC 10's linker cannot parse CubeMX's READONLY output-section attribute.
# Keep the generated linker script intact and use a compatible build copy.
if(CMAKE_C_COMPILER_ID STREQUAL "GNU" AND CMAKE_C_COMPILER_VERSION VERSION_LESS 11)
    set(STM32_LINKER_INPUT "${CMAKE_SOURCE_DIR}/STM32F103XX_FLASH.ld")
    set(STM32_LINKER_COMPAT "${CMAKE_BINARY_DIR}/STM32F103XX_FLASH.gcc10.ld")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${STM32_LINKER_INPUT}")
    file(READ "${STM32_LINKER_INPUT}" STM32_LINKER_CONTENT)
    string(REPLACE "(READONLY)" "" STM32_LINKER_CONTENT "${STM32_LINKER_CONTENT}")
    file(WRITE "${STM32_LINKER_COMPAT}" "${STM32_LINKER_CONTENT}")
    string(REPLACE "${STM32_LINKER_INPUT}" "${STM32_LINKER_COMPAT}"
        CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS}")
endif()
